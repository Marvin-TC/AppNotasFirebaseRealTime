<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkCompletado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false" />
    <LinearLayout
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/checkCompletado"
        android:layout_toLeftOf="@id/btnEliminar"
        android:id="@+id/layout_texto"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/textTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título de la tarea"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/textFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-10-16 18:03:01"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>


    <!-- Botón eliminar -->
    <ImageButton
        android:layout_alignParentRight="true"
        android:id="@+id/btnEliminar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar tarea"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</RelativeLayout>